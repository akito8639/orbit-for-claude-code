    "": {},
    "%@ %@": {
      "comment": "A label displaying a title and the current utilization percentage. The first argument is the title. The second argument is the utilization percentage.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %lld%%": {
      "comment": "A small label that displays the name of a usage surface and the percentage of the total usage that it represents. The argument is the percentage, rounded to the nearest whole number.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld%%"
          }
        }
      }
    },
    "%@ — %@": {
