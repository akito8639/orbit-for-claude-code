// Per-developer settings. Copy to Config.local.xcconfig (git-ignored) to override without touching the repo.
#include? "Config.local.xcconfig"

// Apple Developer Team ID (Xcode > Settings > Accounts). Required for the App Group shared by app and widget.
DEVELOPMENT_TEAM = DGV8253YN4

// App Group shared between the menu bar app and the widget extension. macOS style: <TeamID>.<identifier>.
APP_GROUP_ID = $(DEVELOPMENT_TEAM).com.kazuhide.OrbitForClaudeCode

// Bundle identifier prefix. The app is $(BUNDLE_ID_PREFIX).OrbitForClaudeCode, the widget $(BUNDLE_ID_PREFIX).OrbitForClaudeCode.widget.
BUNDLE_ID_PREFIX = com.kazuhide
